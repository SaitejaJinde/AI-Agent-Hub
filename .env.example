# Environment example file for local development

# Provide a Google API key if you want to use the real Google generative LLM.
# Example:
# GOOGLE_API_KEY=ya29.A0...your_key_here
GOOGLE_API_KEY=

# When true, the backend will use a small Mock LLM that returns deterministic
# responses. Set to 'false' to attempt to use the real LLM (requires GOOGLE_API_KEY).
USE_MOCK_LLM=true
